# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

SECRET_KEY=replace-this-with-a-real-secret-key

# Set to True for local development
DEBUG=True

# Comma-separated list of hostnames Django will serve
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for POST forms/CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# This branch always uses the local SQLite database at ./db.sqlite3.
# DATABASE_URL is intentionally ignored here.
