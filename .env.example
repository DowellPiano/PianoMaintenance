# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

SECRET_KEY=replace-this-with-a-real-secret-key

# Set to True only for local development — never in production
DEBUG=False

# Comma-separated list of hostnames Django will serve.
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1
# Render:        ALLOWED_HOSTS=your-render-service-name.onrender.com
# Production:    ALLOWED_HOSTS=myapp.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated trusted origins for Django POST forms/CSRF.
# Must match exactly (scheme + host + optional port).
# Development:   CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Render:        CSRF_TRUSTED_ORIGINS=https://your-render-service-name.onrender.com
# Production:    CSRF_TRUSTED_ORIGINS=https://myapp.com,https://www.myapp.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave unset for SQLite. Set this for Postgres later if needed.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DB_SSL_REQUIRE=True

# Optional demo deployment convention:
# run `python3 manage.py reset_demo_data --yes` during release/startup to replace
# the database with realistic editable sample data.
DEMO_DATA_RESET_ON_DEPLOY=False

# Optional frictionless demo login. Enable only for public/demo testing
# deployments, not for a real production workspace.
DEMO_AUTO_LOGIN=False
DEMO_AUTO_LOGIN_USERNAME=demo-admin
