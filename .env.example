# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

SECRET_KEY=replace-this-with-a-real-secret-key

# Set to True only for local development — never in production
DEBUG=False

# Comma-separated list of hostnames Django will serve
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1
# Production:    ALLOWED_HOSTS=myapp.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins the browser is allowed to call from
# Must match exactly (scheme + host + port)
# Development:   CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production:    CORS_ALLOWED_ORIGINS=https://myapp.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email notifications. For Gmail, use a Google App Password, not the account password.
EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-app-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL="Piano Maintainer <your-app-gmail-address@gmail.com>"
