# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

SECRET_KEY=replace-this-with-a-real-secret-key

# Set to True only for local development — never in production
DEBUG=False

# Comma-separated list of hostnames Django will serve
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1
# Production:    ALLOWED_HOSTS=myapp.com,www.myapp.com
ALLOWED_HOSTS=app.example.com,.onrender.com

# Comma-separated list of origins trusted for form posts.
# Must match exactly (scheme + host + port).
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Database
# Leave DATABASE_URL unset for the disposable SQLite demo/test-data deployment.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL_REQUIRE=True

# Email
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=smtp-user
EMAIL_HOST_PASSWORD=smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Private media / Supabase S3-compatible storage
PRIVATE_MEDIA_URL_TTL=900
SUPABASE_S3_ACCESS_KEY_ID=replace-me
SUPABASE_S3_SECRET_ACCESS_KEY=replace-me
SUPABASE_S3_BUCKET=replace-me
SUPABASE_S3_ENDPOINT=https://project-ref.supabase.co/storage/v1/s3
SUPABASE_REGION=us-east-1

# HTTPS/security. Leave these enabled in production.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Enable when Django is behind a proxy/load balancer that sets X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False

# Disposable demo/test-data deployment. This branch keeps the SaaS user
# experience but resets to realistic SQLite-backed sample data on startup.
DEMO_DATA_RESET_ON_DEPLOY=True
DEMO_AUTO_LOGIN=True
DEMO_AUTO_LOGIN_USERNAME=demo-admin

# Lets the disposable demo serve CSS/JS directly from app static folders if a
# host misses collectstatic. Defaults to DEMO_DATA_RESET_ON_DEPLOY.
# WHITENOISE_USE_FINDERS=True
