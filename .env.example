# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

SECRET_KEY=replace-this-with-a-real-secret-key

# Set to True only for local development — never in production
DEBUG=False

# Comma-separated list of hostnames Django will serve
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1
# Production:    ALLOWED_HOSTS=myapp.com,www.myapp.com
ALLOWED_HOSTS=app.example.com

# Comma-separated list of origins trusted for form posts.
# Must match exactly (scheme + host + port).
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Database
# Use the external/session-pooler Postgres URL supplied by your host.
# Add sslmode=require unless your provider explicitly says SSL is not supported.
# Supabase direct example:
# DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=True

# Email
EMAIL_NOTIFICATIONS_ENABLED=False
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=re_replace_me
EMAIL_TIMEOUT=10

# Error monitoring. Disabled automatically in DEBUG unless explicitly enabled.
SENTRY_ENABLED=True
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=production
# Render exposes RENDER_GIT_COMMIT automatically; override only if needed.
# SENTRY_RELEASE=

# Off-site database and media backups (Backblaze B2 S3-compatible API)
# BACKUP_DATABASE_URL may use a dedicated Supabase direct/session connection;
# when blank, the application DATABASE_URL is used.
BACKUP_DATABASE_URL=
BACKUP_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKUP_S3_REGION=us-east-005
BACKUP_S3_BUCKET=overtone-backup-unique-suffix
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
BACKUP_S3_PREFIX=overtone
BACKUP_OBJECT_LOCK_DAYS=30

# SMTP fallback, only used when EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=smtp-user
# EMAIL_HOST_PASSWORD=smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Private media / Supabase S3-compatible storage
PRIVATE_MEDIA_URL_TTL=900
SUPABASE_S3_REQUIRED=True
SUPABASE_S3_ACCESS_KEY_ID=replace-me
SUPABASE_S3_SECRET_ACCESS_KEY=replace-me
SUPABASE_S3_BUCKET=replace-me
SUPABASE_S3_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_REGION=us-west-2

# HTTPS/security. Leave these enabled in production.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Enable when Django is behind a proxy/load balancer that sets X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False
